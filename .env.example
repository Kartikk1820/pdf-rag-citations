# ---------------------------------------------------------------------------
# LLM provider. The app talks to an OpenAI-compatible endpoint, so switching
# provider is just a matter of which block below is active.
#
#   openrouter -> satisfies the assignment (free model), needs OPENROUTER_API_KEY
#   groq       -> fallback for demo reliability, needs GROQ_API_KEY
# ---------------------------------------------------------------------------
LLM_PROVIDER=openrouter

# --- OpenRouter (default) --------------------------------------------------
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# --- Groq (fallback) -------------------------------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Vector store ----------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pdf_documents

# --- Embeddings (local, free, offline via fastembed) -----------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Retrieval tuning ------------------------------------------------------
TOP_K=8
# Cosine similarity below this is treated as "no relevant context found".
SCORE_THRESHOLD=0.3
