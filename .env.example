# ---------------------------------------------------------------------------
# LLM provider. The app talks to an OpenAI-compatible endpoint, so switching
# provider is just a matter of which block below is active.
#
#   openrouter -> satisfies the assignment (free model), needs OPENROUTER_API_KEY
#   groq       -> fallback for demo reliability, needs GROQ_API_KEY
#
# You can also set these from the app itself: Settings screen -> LLM Provider.
# ---------------------------------------------------------------------------
LLM_PROVIDER=openrouter

# --- OpenRouter (default) --------------------------------------------------
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# --- Groq (fallback) -------------------------------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Vector store (embedded Qdrant -- a local directory, no server/Docker) -
QDRANT_PATH=./storage/qdrant
QDRANT_COLLECTION=pdf_documents

# --- Local folders ----------------------------------------------------------
DATA_DIR=./data
STORAGE_DIR=./storage

# --- Embeddings (local, free, offline via fastembed) -----------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Reranking (ONNX cross-encoder, local, offline via fastembed) ----------
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# --- Retrieval tuning --------------------------------------------------------
# How many candidates the hybrid search pulls before reranking.
RETRIEVAL_K=20
# How many reranked chunks are finally sent to the LLM.
TOP_K=5
# Cross-encoder relevance score below this is treated as "no relevant context
# found" (the LLM is never called in that case).
SCORE_THRESHOLD=0.3
# Weight given to BM25 (lexical) vs. dense retrieval when fusing rankings.
# 0.0 = dense only, 1.0 = lexical only.
HYBRID_BM25_WEIGHT=0.4

# --- Pipeline features (also toggleable from the Settings screen) ----------
ENABLE_HYBRID=true
ENABLE_QUERY_REWRITE=true
# When nothing in the documents is relevant: reply to casual messages ("hi")
# naturally, and answer other questions from general knowledge (clearly
# labeled, no citations), instead of always refusing.
ENABLE_GENERAL_FALLBACK=true
